# SankatSetu AI Environment Configuration

# Gemini API Key (Leave empty to run in deterministic DEMO MODE)
GEMINI_API_KEY=

# Model to use (Official current Gemini model)
GEMINI_MODEL=gemini-3.8-flash

# Database path (SQLite)
DATABASE_PATH=sanketsetu.db

# Server settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
